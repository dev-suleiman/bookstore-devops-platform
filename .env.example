# Copy this file to .env and adjust as needed.

PORT=3000
NODE_ENV=development

# Local Postgres, matching docker-compose.yml
DATABASE_URL="postgresql://bookstore:bookstore@localhost:5432/bookstore?schema=public"

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# Mock payment provider tuning - used to generate realistic latency and
# failure-rate telemetry without a real payment gateway.
PAYMENT_MIN_LATENCY_MS=100
PAYMENT_MAX_LATENCY_MS=600
PAYMENT_FAILURE_RATE=0.1
