// Prisma schema for the book store platform.
//
// Scope note: this models exactly what the MVP flow needs (register, browse,
// cart, order, pay, notify) and deliberately leaves out reviews, coupons,
// shipping addresses, and inventory reservation logic. Extending the schema
// for those is a later, separate exercise.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationStatus {
  SENT
  FAILED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  cartItems     CartItem[]
  orders        Order[]
  notifications Notification[]

  @@map("users")
}

model Book {
  id          String      @id @default(uuid())
  title       String
  author      String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([title])
  @@index([author])
  @@map("books")
}

model CartItem {
  id       String @id @default(uuid())
  userId   String
  bookId   String
  quantity Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("cart_items")
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user          User            @relation(fields: [userId], references: [id])
  items         OrderItem[]
  payment       Payment?
  notifications Notification[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  bookId   String
  quantity Int
  price    Decimal @db.Decimal(10, 2) // snapshot of the book price at order time

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id])

  @@map("order_items")
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String        @unique
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  provider  String        @default("mock")
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  orderId   String?
  type      String
  message   String
  status    NotificationStatus @default(SENT)
  createdAt DateTime           @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@map("notifications")
}
